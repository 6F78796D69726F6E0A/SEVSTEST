---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Specialist Endovascular Services | SEVS Sydney" heading="Expert care for complex vascular conditions" description="Specialist consultation and minimally invasive endovascular treatment in Sydney.">
<section class="mx-auto max-w-7xl px-5 py-16 lg:px-8"><div class="grid gap-6 md:grid-cols-3">
<a href="/aneurysm/" class="rounded-3xl bg-brand-50 p-7 no-underline"><span class="text-sm font-bold text-brand-700">Conditions</span><h2 class="mt-3 text-2xl">Understand your diagnosis</h2><p>Clear information about aneurysms and vascular conditions, assessment and treatment pathways.</p></a>
<a href="/about/specialists/" class="rounded-3xl bg-sand p-7 no-underline"><span class="text-sm font-bold text-brand-700">Our specialists</span><h2 class="mt-3 text-2xl">Meet the clinical team</h2><p>Learn about the specialists providing endovascular and neurointerventional care.</p></a>
<a href="/patient-information/referral/" class="rounded-3xl bg-slate-50 p-7 no-underline"><span class="text-sm font-bold text-brand-700">Referrals</span><h2 class="mt-3 text-2xl">Plan your consultation</h2><p>Referral, appointment, hospital admission and procedure information in one place.</p></a>
</div></section>
<section class="bg-brand-900 text-white"><div class="mx-auto max-w-7xl px-5 py-16 lg:px-8"><p class="text-sm font-bold uppercase tracking-[.18em] text-brand-100">Patient pathways</p><h2 class="max-w-3xl text-white">Specialist assessment from diagnosis through treatment and follow-up.</h2><div class="mt-8 flex flex-wrap gap-3"><a href="/booking/" class="rounded-full bg-white px-5 py-3 font-semibold text-brand-900">Request an appointment</a><a href="/procedures/overview/" class="rounded-full border border-white/30 px-5 py-3 font-semibold text-white">Explore procedures</a></div></div></section>
</BaseLayout>
