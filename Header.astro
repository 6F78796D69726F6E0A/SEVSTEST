---
const path = Astro.url.pathname;
const nav = [
 {label:'About',href:'/about/'},
 {label:'Specialists',href:'/about/specialists/'},
 {label:'Conditions',href:'/conditions/'},
 {label:'Procedures',href:'/procedures/overview/'},
 {label:'Patient information',href:'/patient-information/all/'},
 {label:'Contact',href:'/contact-us/'}
];
---
<header class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/95 backdrop-blur">
 <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-5 py-4 lg:px-8">
  <a href="/" class="flex items-center gap-3 no-underline" aria-label="SEVS home">
   <span class="grid size-11 place-items-center rounded-full bg-brand-700 text-lg font-bold text-white">S</span>
   <span><span class="block text-sm font-bold tracking-[.18em] text-brand-700">SEVS</span><span class="hidden text-xs text-slate-500 sm:block">Specialist Endovascular Services</span></span>
  </a>
  <nav class="hidden items-center gap-6 lg:flex" aria-label="Main navigation">
   {nav.map(item => <a href={item.href} class:list={["text-sm font-medium hover:text-brand-700", path.startsWith(item.href) ? "text-brand-700" : "text-slate-700"]}>{item.label}</a>)}
  </nav>
  <div class="flex items-center gap-2"><a href="tel:1300553339" class="hidden rounded-full border border-brand-700 px-4 py-2 text-sm font-semibold text-brand-700 sm:inline-flex">1300 553 339</a><a href="/booking/" class="rounded-full bg-brand-700 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-600">Book appointment</a></div>
 </div>
 <details class="border-t border-slate-100 lg:hidden"><summary class="cursor-pointer px-5 py-3 text-sm font-semibold">Menu</summary><nav class="grid gap-1 px-5 pb-4">{nav.map(item => <a href={item.href} class="rounded-lg px-3 py-2 text-sm hover:bg-brand-50">{item.label}</a>)}</nav></details>
</header>
