---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title="Page not found | SEVS" heading="Page not found" description="The page you requested could not be found."><section class="mx-auto max-w-4xl px-5 py-16"><a class="text-brand-700 underline" href={`${base}/`}>Return to the SEVS home page</a></section></BaseLayout>
