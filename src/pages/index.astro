---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (href) => `${base}${href}`;
const doctors=[
 {name:'Dr Ken Faulder',role:'Interventional Neuroradiologist',image:'/images/specialists/ken-faulder.jpg',href:'/about/dr-ken-faulder/'},
 {name:'Dr Brendan Steinfort',role:'Interventional Neuroradiologist',image:'/images/specialists/brendan-steinfort.jpg',href:'/about/dr-brendan-steinfort/'},
 {name:'Dr Alice Ma',role:'Neurologist & Neurointerventionist',image:'/images/specialists/alice-ma.jpg',href:'/about/dr-alice-ma/'},
 {name:'Dr Blake Giarola',role:'Neurointerventionist',image:'/images/specialists/blake-giarola.png',href:'/about/dr-blake-giarola/'}
];
const conditions=[
 {title:'Brain aneurysms',text:'Assessment, surveillance and contemporary endovascular treatment options.',href:'/conditions/brain-aneurysm/'},
 {title:'Carotid artery stenosis',text:'Specialist assessment of symptomatic and asymptomatic carotid disease.',href:'/conditions/carotid-artery-stenosis/'},
 {title:'AVMs & vascular malformations',text:'Multidisciplinary evaluation and endovascular treatment of complex vascular lesions.',href:'/conditions/arteriovenous-malformation/'},
 {title:'Pulsatile tinnitus',text:'Investigation of vascular causes of pulse-synchronous tinnitus.',href:'/conditions/pulsatile-tinnitus/'}
];
---
<BaseLayout hero={false} title="Specialist Endovascular Services | SEVS Sydney" heading="" description="Sydney specialists in neurointervention and minimally invasive endovascular treatment.">
<section class="home-hero"><div class="mx-auto grid max-w-7xl items-center gap-12 px-5 py-16 lg:grid-cols-[1.05fr_.95fr] lg:px-8 lg:py-24"><div><div class="brand-kicker"><span class="brand-line"></span> SPECIALIST ENDOVASCULAR SERVICES</div><h1 class="home-title">Expert neurovascular care.<br/><em>Minimally invasive.</em></h1><p class="home-lead">Sydney specialists in the diagnosis and endovascular treatment of brain aneurysms, stroke and complex vascular conditions.</p><div class="mt-8 flex flex-wrap gap-3"><a href={url('/booking/')} class="button-primary">Request an appointment</a><a href={url('/about/our-specialists/')} class="button-secondary">Meet our specialists</a></div><div class="hero-trust"><span>Royal North Shore</span><span>Westmead</span><span>Major Sydney private hospitals</span></div></div><div class="hero-imaging"><div class="hero-image-main"><img src={url('/images/clinical/flow-diversion-1.png')} alt="Cerebral angiographic imaging used in neurointerventional treatment"/><div class="image-label">NEUROINTERVENTION · SYDNEY</div></div><div class="hero-image-small"><img src={url('/images/clinical/flow-diverter-device.png')} alt="Flow diverter device used in aneurysm treatment"/></div></div></div></section>

<section class="stats-band"><div class="mx-auto grid max-w-7xl grid-cols-2 gap-px px-5 md:grid-cols-4 lg:px-8"><div><strong>800+</strong><span>Neurointerventional procedures annually</span></div><div><strong>300+</strong><span>Aneurysm treatments annually</span></div><div><strong>300+</strong><span>Acute stroke procedures annually</span></div><div><strong>1000+</strong><span>Diagnostic cerebral angiograms annually</span></div></div></section>

<section class="section-shell"><div class="section-heading"><div><p class="section-kicker">OUR SPECIALISTS</p><h2>Experience when it matters.</h2></div><p>Four fellowship-trained neurointerventionists combining radiology and neurology backgrounds in a specialist multidisciplinary practice.</p></div><div class="doctor-grid">{doctors.map(d=><a href={url(d.href)} class="doctor-card"><div class="doctor-image"><img src={url(d.image)} alt={d.name}/></div><div class="doctor-copy"><h3>{d.name}</h3><p>{d.role}</p><span>View profile →</span></div></a>)}</div></section>

<section class="conditions-section"><div class="section-shell"><div class="section-heading"><div><p class="section-kicker">CONDITIONS WE TREAT</p><h2>Specialist care for complex vascular disease.</h2></div><p>Clear information about diagnosis, investigation and treatment options, with recommendations tailored to each patient.</p></div><div class="condition-grid">{conditions.map((c,i)=><a href={url(c.href)} class="condition-card"><span>0{i+1}</span><h3>{c.title}</h3><p>{c.text}</p><b>Learn more →</b></a>)}</div></div></section>

<section class="section-shell"><div class="feature-split"><div class="feature-image"><img src={url('/images/clinical/brain-aneurysm-1.jpg')} alt="Cerebral aneurysm angiographic imaging"/></div><div class="feature-copy"><p class="section-kicker">OUR APPROACH</p><h2>The right treatment, not simply an endovascular treatment.</h2><p>Not every vascular condition is best managed by one technique. SEVS works closely with neurosurgical, neurological and other specialist colleagues to recommend observation, endovascular treatment or open surgery according to the individual clinical circumstances.</p><a href={url('/about/us/')} class="text-cta">About SEVS and our approach →</a></div></div></section>

<section class="care-band"><div class="section-shell"><p class="section-kicker light">PATIENT CARE</p><h2>From diagnosis through treatment and follow-up.</h2><div class="care-grid"><a href={url('/patient-information/referral/')}><span>01</span><h3>Referral & consultation</h3><p>What to bring, imaging transfer and preparing for your specialist appointment.</p></a><a href={url('/procedures/overview/')}><span>02</span><h3>Procedures</h3><p>Understand angiography and minimally invasive endovascular treatments.</p></a><a href={url('/patient-information/hospitals/')}><span>03</span><h3>Hospitals & admission</h3><p>Information about treatment locations, admission and recovery.</p></a></div></div></section>
</BaseLayout>
