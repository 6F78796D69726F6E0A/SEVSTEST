---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (href) => `${base}${href}`;
---
<footer class="mt-20 bg-brand-900 text-white"><div class="mx-auto grid max-w-7xl gap-10 px-5 py-14 md:grid-cols-4 lg:px-8"><div class="md:col-span-2"><p class="text-lg font-semibold text-white">Specialist Endovascular Services</p><p class="max-w-xl text-sm text-white/70">Specialist consultation and minimally invasive endovascular treatment for vascular conditions affecting the brain, head, neck, spine and body.</p></div><div><p class="font-semibold text-white">Patients</p><div class="mt-3 grid gap-2 text-sm text-white/75"><a href={url("/booking/")}>Appointments</a><a href={url("/patient-information/referral/")}>Referrals</a><a href={url("/patient-information/all/")}>Patient information</a></div></div><div><p class="font-semibold text-white">Contact</p><div class="mt-3 grid gap-2 text-sm text-white/75"><a href="tel:1300553339">1300 553 339</a><a href="mailto:admin@sevs.com.au">admin@sevs.com.au</a><a href={url("/contact-us/")}>Locations</a></div></div></div><div class="border-t border-white/10"><div class="mx-auto flex max-w-7xl flex-wrap justify-between gap-4 px-5 py-5 text-xs text-white/55 lg:px-8"><span>© {new Date().getFullYear()} SEVS</span><span class="flex gap-4"><a href={url("/privacy-policy/")}>Privacy</a><a href={url("/terms-of-use/")}>Terms</a></span></div></div></footer>
