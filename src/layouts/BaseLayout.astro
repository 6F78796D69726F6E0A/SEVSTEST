---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const {title, description='Specialist Endovascular Services', heading, eyebrow='Specialist Endovascular Services', hero=true}=Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html><html lang="en-AU"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta name="theme-color" content="#064c4b"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:type" content="website"/><title>{title}</title></head><body><Header/><main>{hero && <section class="overflow-hidden bg-sand"><div class="mx-auto grid max-w-7xl gap-10 px-5 py-16 md:py-24 lg:grid-cols-[1fr_.6fr] lg:px-8"><div><p class="mb-5 text-xs font-bold uppercase tracking-[.2em] text-brand-700">{eyebrow}</p><h1>{heading}</h1>{description && <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600">{description}</p>}</div><div class="hidden items-end justify-end lg:flex"><div class="h-52 w-52 rounded-[40%_60%_55%_45%] bg-brand-100 ring-[28px] ring-white/50"></div></div></div></section>}<slot/></main><Footer/></body></html>
